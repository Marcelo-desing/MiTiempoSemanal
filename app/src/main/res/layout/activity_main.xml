<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#F8F9FA">

    <!-- Título de la app que se te había borrado -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marcelo Allccarima.\nv1.0.0 (4)"
        android:textSize="16sp"
        android:textAlignment="center"
        android:textColor="#757575"
        android:textStyle="italic"
        android:layout_marginBottom="48dp"/>

    <!-- Tu nombre y versión actualizados -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marcelo Allccarima.\nv0.3.0 (3)"
        android:textSize="16sp"
        android:textAlignment="center"
        android:textColor="#757575"
        android:textStyle="italic"
        android:layout_marginBottom="48dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIrCategorias"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Gestionar Categorías"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:backgroundTint="#6200EA"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIrTareas"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Gestionar Tareas"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:backgroundTint="#03DAC5"
        android:textColor="#000000"
        android:layout_marginBottom="16dp" /> <!-- Le agregué margen aquí -->

    <!-- El nuevo botón de Eventos -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIrEventos"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Registrar Eventos"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:backgroundTint="#FF4081"
        android:textColor="#FFFFFF" />

    <!-- El nuevo botón de Reportes -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIrReportes"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Ver Reportes Semanales"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp" />

</LinearLayout>