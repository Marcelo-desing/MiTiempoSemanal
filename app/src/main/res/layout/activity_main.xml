<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mi Tiempo\nSemanal"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"/>

    <!-- Aquí está tu nombre y versión como exige la rúbrica -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marcelo Allccarima.\nv0.1.0 (1)"
        android:textSize="16sp"
        android:textAlignment="center"
        android:textColor="#757575"
        android:textStyle="italic"
        android:layout_marginBottom="48dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIrCategorias"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Gestionar Categorías"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:backgroundTint="#6200EA"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIrTareas"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Gestionar Tareas"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:backgroundTint="#03DAC5"
        android:textColor="#000000" />

</LinearLayout>