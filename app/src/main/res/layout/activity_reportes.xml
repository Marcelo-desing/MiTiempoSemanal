<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reportes Semanales"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona una semana pasada:"
        android:textSize="14sp"
        android:textColor="#757575"
        android:layout_marginBottom="8dp"/>

    <!-- Spinner para elegir la semana (HU-08) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="55dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="16dp">

        <Spinner
            android:id="@+id/spinnerSemanas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </androidx.cardview.widget.CardView>

    <!-- Mensaje si no hay reportes aún -->
    <TextView
        android:id="@+id/tvSinReportes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aún no hay reportes."
        android:textSize="16sp"
        android:textColor="#F44336"
        android:textStyle="bold"
        android:textAlignment="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <!-- Contenedor donde dibujaremos las barras de porcentaje -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvPanelReporte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/llPanelEstadisticas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eventos de esa semana:"
        android:textSize="14sp"
        android:textColor="#757575"
        android:layout_marginBottom="8dp"/>

    <!-- Lista de eventos de la semana seleccionada -->
    <ListView
        android:id="@+id/lvEventosReporte"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"/>

</LinearLayout>